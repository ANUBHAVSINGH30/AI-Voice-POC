generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Call {
  id           String    @id @default(uuid())
  name         String
  purpose      String
  callbackTime DateTime?
  createdAt    DateTime  @default(now())
}