generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Call {
  id           String    @id @default(uuid())
  name         String
  purpose      String
  callbackTime DateTime?
  createdAt    DateTime  @default(now())
}
