generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Call {
  id           String   @id @default(uuid())
  name         String
  purpose      String
  calledAt     DateTime @default(now())
  callbackTime DateTime
  phoneNumber  String?
  createdAt    DateTime @default(now())
}